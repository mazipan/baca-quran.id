{
	"name": "my-app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "svelte-kit sync && vite build && pnpm run make:timestamp && pnpm run make:sitemap",
		"build:ci": "svelte-kit sync && CI_BUILD=true vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"format": "prettier --plugin-search-dir . --write .",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"make:sitemap": "node ./scripts/makeSitemap.js",
		"make:timestamp": "node ./scripts/makeTimestamp.js",
		"prepare": "svelte-kit sync && husky",
		"preview": "vite preview"
	},
	"dependencies": {
		"@fontsource/amiri": "5.3.0",
		"@fontsource/amiri-quran": "5.3.0",
		"@fontsource/noto-naskh-arabic": "5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"dayjs": "1.11.23",
		"firebase": "13.1.0",
		"kfgqpc-uthmanic-script-hafs-regular": "1.0.0",
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-auto": "8.0.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/postcss": "4.3.3",
		"@typescript-eslint/eslint-plugin": "8.72.0",
		"@typescript-eslint/parser": "8.72.0",
		"autoprefixer": "10.6.1",
		"dotenv": "18.0.9",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"globby": "16.2.4",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"postcss": "8.5.31",
		"postcss-load-config": "6.0.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"schema-dts": "2.1.0",
		"sitemaps": "2.0.6",
		"svelte-check": "4.7.7",
		"svelte-eslint-parser": "1.10.0",
		"tailwindcss": "4.3.3",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=26.12",
		"pnpm": ">=12.15.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	}
}
